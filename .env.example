# ══════════════════════════════════════════════════════════════════════════════
# local-rag — environment template
# Copy this file to .env and fill in values for your chosen model runtime.
#
# Two interchangeable runtimes — both expose the same OpenAI-compatible API:
#   Path A: LM Studio  (GUI, one server on :1234, routes by model id)
#   Path B: llama.cpp  (CLI, three llama-server processes on :8080/:8081/:8082)
# ══════════════════════════════════════════════════════════════════════════════

# ── Path A: LM Studio ────────────────────────────────────────────────────────
# Start LM Studio, load one model of each kind, then start its local server.
# All three BASE_URLs point at the same port; the MODEL values must match
# exactly what `lms ps` reports (LM Studio routes requests by model id).
#
# LLM_BASE_URL=http://127.0.0.1:1234/v1
# LLM_MODEL=ministral-3-14b-instruct-2512
#
# EMBED_BASE_URL=http://127.0.0.1:1234/v1
# EMBED_MODEL=text-embedding-nomic-embed-text-v1.5
#
# VLM_BASE_URL=http://127.0.0.1:1234/v1
# VLM_MODEL=zai-org/glm-4.6v-flash
#
# OPENAI_API_KEY=lm-studio

# ── Path B: llama.cpp ────────────────────────────────────────────────────────
# Run ./scripts/serve.sh — it starts three llama-server processes.
# The MODEL values can be any non-empty string (they're passed in the request
# but llama-server ignores them when only one model is loaded).

LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=local-chat

EMBED_BASE_URL=http://127.0.0.1:8081/v1
EMBED_MODEL=local-embed

VLM_BASE_URL=http://127.0.0.1:8082/v1
VLM_MODEL=local-vlm

# llama-server ignores the key but the OpenAI client requires a non-empty value.
OPENAI_API_KEY=sk-no-key-required

# ── ColPali visual retrieval (runs in-process via colpali-engine) ─────────────
# vidore/colqwen2-v1.0 downloads automatically on first ingest (~5 GB).
COLPALI_MODEL=vidore/colqwen2-v1.0
# torch device: mps (Apple Silicon), cuda, or cpu
COLPALI_DEVICE=mps

# ── Storage & data paths ──────────────────────────────────────────────────────
DATA_DIR=./data
STORAGE_DIR=./storage

# ── Retrieval knobs ───────────────────────────────────────────────────────────
TEXT_TOP_K=5
VISUAL_TOP_K=3
MAX_AGENT_ITERATIONS=3
