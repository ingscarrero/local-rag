# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Environment — copy .env.example and fill in your values; never commit secrets
.env*
!.env.example

# Credentials / certificates — never commit
*.pem
*.key
*.p12

# Runtime artefacts — generated at run time, not part of source
storage/
data/*
!data/.gitkeep

# macOS
.DS_Store

# IDE / editor
.claude/
.idea/
.vscode/
